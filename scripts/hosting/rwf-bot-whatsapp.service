[Unit]
Description=RWF WhatsApp bot (via Qalarc Hub — requires Hub reachable)
After=network-online.target

[Service]
# If the Hub runs on another box, prefix ExecStart with an autossh tunnel, e.g.:
#   autossh -M 0 -N -L 8769:127.0.0.1:8769 fivelidz@superlocal & sleep 2 && bun ...
Type=simple
WorkingDirectory=%h/reps_with_friends/apps/bot-whatsapp
ExecStart=/home/qalarc/.bun/bin/bun main.ts --live
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
